# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.
# O arquivo ".env" nao e versionado (ver .gitignore).

# Caminho local do APK do aplicativo sob teste.
# Se nao for definido, o valor padrao e ./apps/android-demo-app.apk
ANDROID_APP_PATH=./apps/android-demo-app.apk

# Nome do dispositivo/AVD usado pelo Appium. Deve corresponder a um
# dispositivo virtual ja criado no Android Studio (AVD Manager).
ANDROID_DEVICE_NAME=medium_phone
ANDROID_AVD_NAME=medium_phone
