{
  "name": "appium-automation-framework",
  "version": "1.0.0",
  "description": "Framework de automacao de testes mobile com Appium, WebdriverIO e TypeScript, utilizando BDD (Cucumber) e Page Object Model.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.31.6",
    "@wdio/cli": "^9.31.6",
    "@wdio/cucumber-framework": "^9.31.6",
    "@wdio/local-runner": "^9.31.6",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "allure-commandline": "^2.43.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "webdriverio": "^9.31.6"
  }
}
